# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Pytest
.pytest_cache

# Stale warehouse layout copy. The canonical, always-current output lives at
# spore-warehouse-layout/output/warehouse.json (generated by
# `uv run spore-warehouse-layout`) - a duplicate here drifts out of sync
# silently since nothing regenerates it.
spore-amr/shared/warehouse-layout.json

# spore-warehouse-layout/output/ should only ever track the two generated
# deliverables - anything else dropped there (logs, intermediate files from a
# future debug run, etc.) stays untracked rather than committed by accident.
spore-warehouse-layout/output/*
!spore-warehouse-layout/output/warehouse.json
!spore-warehouse-layout/output/warehouse_map.svg
